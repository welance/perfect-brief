# Copy to .env and fill in. All vars are prefixed PB_.

# --- LLM judge & suggestions (leave keys empty to run mock-only) ---
# Optional legacy direct-Anthropic adapter. If enabled, PB_MODEL must be changed
# to an Anthropic-direct id; Welance itself uses OpenRouter + DeepSeek only.
PB_ANTHROPIC_API_KEY=
PB_MODEL=deepseek/deepseek-v4-pro
# OR OpenRouter (wins if both keys are set; enables per-request model choice).
# PB_OPENROUTER_MODELS is the allowlist a request may pick from — exact
# vendor-prefixed OpenRouter slugs, comma-separated; the first is the default.
PB_OPENROUTER_API_KEY=
PB_OPENROUTER_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,google/gemini-3.1-flash-lite
# Restriction for caller-supplied keys. Empty means ANY valid slug, including
# the expensive labs — leave this set unless you mean to allow that.
PB_BYOK_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,google/gemini-3.5-flash-lite,google/gemini-3.1-flash-lite,openai/gpt-5-nano,anthropic/claude-haiku-4.5
# Model split: published scoring stays on Pro; interactive drafts use the
# measured low-latency model. The allowlist prevents arbitrary overrides.
PB_SUGGEST_MODEL=google/gemini-3.1-flash-lite
PB_VERIFIER_MODEL=deepseek/deepseek-v4-flash
PB_SUGGEST_VERIFY=false
PB_SUGGEST_PROVIDER_SORT=latency
PB_LLM_MAX_TOKENS=16000
PB_SUGGEST_MAX_TOKENS=800
PB_SUGGEST_ALL_MAX_TOKENS=2000
PB_VERIFIER_MAX_TOKENS=800
# 0 = one call for all rules. Set 5 only after comparing live verdict quality;
# it runs deterministic 5/5/4 batches, at most 3 calls at once.
PB_JUDGE_BATCH_SIZE=0
PB_JUDGE_CONCURRENCY=3
PB_LLM_TIMEOUT_SECONDS=120

# --- Redis (verdict cache + rate limit) ---
PB_REDIS_URL=redis://redis:6379/0
PB_CACHE_TTL_SECONDS=86400

# --- Policy ---
# mock = offline keyword engine (instant, deterministic). llm = server-side judge.
PB_DEFAULT_JUDGE=mock
PB_RATE_LIMIT_PER_MINUTE=60
# Separate budget for anonymous calls charged to the service's own model key.
# BYOK calls are charged to the caller and do not consume this bucket.
PB_PAID_LLM_RATE_LIMIT_PER_MINUTE=10
PB_REQUEST_MAX_CHARS=20000
PB_BYOK_MAX_CHARS=512
# JSON list; lock this down in production, e.g. ["https://welance.com"]
PB_CORS_ORIGINS=["*"]
