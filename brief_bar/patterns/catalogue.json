{
  "schema_version": 1,
  "version": "1.1.0",
  "about": "Deterministic spans and cues shared by the r001-15 mock judge (Python) and the Directory pre-publish scan (JavaScript). Owned here; consumers vendor a pinned copy. Regex sources use the portable dialect in brief_bar/patterns/README.md; group 1, when present, is the span and must end where the match ends. A phone that overruns its digit limit, or that an exclusion hides, backs off to its longest valid prefix. An exclusion hides a phone only when it covers the whole candidate and carries no other digits; national numbers yield only to structural exclusions (dates, tax ids, IBANs), + / 00 numbers and full Italian mobiles to none (fail closed). Subject patterns (budget, timeline) say where a brief already states a subject; group 1 is the value without its label; presence only, never a verdict.",
  "contacts": [
    {
      "id": "email",
      "kind": "email",
      "priority": 40,
      "flags": "",
      "source": "(?:^|[^A-Za-z0-9._%+\\-])([A-Za-z0-9._%+\\-]{1,64}@[A-Za-z0-9\\-]{1,63}(?:\\.[A-Za-z0-9\\-]{1,63}){1,8})",
      "note": "ASCII addresses; the trailing full stop of a sentence stays outside the span"
    },
    {
      "id": "url",
      "kind": "url",
      "priority": 40,
      "flags": "i",
      "source": "(?:^|[^A-Za-z0-9])((?:https?://|www\\.)[^ \\t\\r\\n<>\"'()\\[\\]{}]{0,2000}[^ \\t\\r\\n<>\"'()\\[\\]{}.,;:!?])",
      "note": "scheme or www.; closing punctuation and Markdown brackets stay outside"
    },
    {
      "id": "phone.intl",
      "kind": "phone",
      "priority": 30,
      "flags": "",
      "min_digits": 8,
      "max_digits": 15,
      "source": "(?:^|[^0-9A-Za-z+_@/€$£.,]|[A-Za-z][.:,])((?:\\+|00)[1-9][0-9]{0,2}(?:[ .\\-]?\\(?[0-9]{1,4}\\)?){2,6})(?![0-9A-Za-z_@€$£%]|[.,][0-9])",
      "note": "+CC or 00CC, then up to six groups: +39 02 1234567, +44 (0)20 7946 0958, 0049 30 1234567; a + or 00 prefix is never excluded",
      "never_excluded_from_digits": 8
    },
    {
      "id": "phone.it.mobile",
      "kind": "phone",
      "priority": 20,
      "flags": "",
      "min_digits": 9,
      "max_digits": 10,
      "source": "(?:^|[^0-9A-Za-z+_@/€$£.,]|[A-Za-z][.:,])(3[1-9][0-9](?:[ .\\-/]|[ ][/\\-][ ])?[0-9]{3}[ .\\-/]?[0-9]{3,4})(?![0-9A-Za-z_@€$£%]|[.,][0-9])",
      "note": "Italian mobile without prefix (31x-39x; no 30x range exists): 347 123 4567, 347-1234567, 3471234567; a complete 10-digit mobile is never excluded; 347 - 123 4567",
      "never_excluded_from_digits": 10
    },
    {
      "id": "phone.trunk",
      "kind": "phone",
      "priority": 20,
      "flags": "",
      "min_digits": 8,
      "max_digits": 12,
      "source": "(?:^|[^0-9A-Za-z+_@/€$£.,]|[A-Za-z][.:,])(\\(?0[1-9][0-9]{0,3}\\)?(?:[ .\\-/]|[ ][/\\-][ ])?[0-9]{2,4}(?:(?:[ .\\-/]|[ ]/[ ])?[0-9]{2,4}){0,3})(?![0-9A-Za-z_@€$£%]|[.,][0-9])",
      "note": "national numbers with a trunk 0 (IT landlines, DE, FR, UK, NL...): 02 1234567, 030 12345678, 01 23 45 67 89, 020 7946 0958; a spaced ' / ' anywhere (030 / 123 / 45678) but a spaced ' - ' only right after the area code (02 - 1234567), so a following ' - 5000 €' never joins the number and pushes it past max_digits",
      "hidden_only_by_structural": true
    },
    {
      "id": "phone.nanp",
      "kind": "phone",
      "priority": 20,
      "flags": "",
      "min_digits": 10,
      "max_digits": 10,
      "source": "(?:^|[^0-9A-Za-z+_@/€$£.,]|[A-Za-z][.:,])(\\(?[2-9][0-9]{2}\\)?[ .\\-][0-9]{3}[ .\\-][0-9]{4})(?![0-9A-Za-z_@€$£%]|[.,][0-9])",
      "note": "US/Canada national format with separators: (212) 555-1234, 212.555.1234",
      "hidden_only_by_structural": true
    }
  ],
  "exclusions": [
    {
      "id": "amount.currency-after",
      "flags": "i",
      "source": "(?:^|[^0-9.,])([0-9](?:[0-9.,']|[ \\u00a0\\u202f](?=[0-9])){0,24}[ \\u00a0\\u202f]?(?:€|eur|euro|chf|usd|gbp|\\$|£|k(?![a-z])|%))",
      "note": "3000 €, 10 000 EUR, 25k, 30 %"
    },
    {
      "id": "amount.currency-before",
      "flags": "i",
      "source": "((?:€|\\$|£|eur|usd|chf|gbp)[ \\u00a0\\u202f]?[0-9](?:[0-9.,']|[ \\u00a0\\u202f](?=[0-9])){0,24})",
      "note": "€ 3000, EUR 12.000"
    },
    {
      "id": "range.amount",
      "flags": "i",
      "source": "(?:^|[^0-9.,])([0-9](?:[0-9.,']|[ \\u00a0\\u202f](?=[0-9])){0,24}[ \\u00a0\\u202f]{0,2}(?:-|–|—|to|a|bis|à|al|tot|do|e)[ \\u00a0\\u202f]{0,2}[0-9](?:[0-9.,']|[ \\u00a0\\u202f](?=[0-9])){0,24}[ \\u00a0\\u202f]?(?:€|eur|euro|chf|usd|gbp|\\$|£|k(?![a-z])|%))",
      "note": "3000 - 5000 €, 10.000–30.000 EUR"
    },
    {
      "id": "range.worded",
      "flags": "i",
      "source": "(?:^|[^A-Za-z])((?:tra|fra|between|from|da|zwischen|von|entre|de|van|tussen|od|między)[ \\u00a0\\u202f]{1,2}(?:€|\\$|£|eur|usd|chf|gbp)?[ \\u00a0\\u202f]?[0-9](?:[0-9.,']|[ \\u00a0\\u202f](?=[0-9])){0,24}[ \\u00a0\\u202f]{0,2}(?:-|–|—|to|a|bis|à|al|tot|do|e)[ \\u00a0\\u202f]{0,2}(?:€|\\$|£|eur|usd|chf|gbp)?[ \\u00a0\\u202f]?[0-9](?:[0-9.,']|[ \\u00a0\\u202f](?=[0-9])){0,24})",
      "note": "tra 3000 - 5000, between 10000 and 30000"
    },
    {
      "id": "number.grouped",
      "flags": "",
      "source": "(?:^|[^0-9.,])([0-9]{1,3}(?:[.,'][0-9]{3}){2,6})(?![.,]?[0-9])",
      "note": "thousands-grouped numbers: 350.000.000 (a dotted 3-3-3 group is read as a number, not a phone)"
    },
    {
      "id": "date.dmy",
      "flags": "",
      "source": "(?:^|[^0-9])([0-9]{1,2}[./\\-][0-9]{1,2}[./\\-][0-9]{2,4})(?![0-9])",
      "note": "12/03/2025, 01.02.2025",
      "structural": true
    },
    {
      "id": "date.iso",
      "flags": "",
      "source": "(?:^|[^0-9])([0-9]{4}-[0-9]{2}-[0-9]{2})(?![0-9])",
      "note": "2025-03-12",
      "structural": true
    },
    {
      "id": "tax-id.it-piva",
      "flags": "i",
      "source": "(?:^|[^A-Za-z])((?:p\\. ?iva|p\\.iva|piva|partita iva)[ :.#\\u00a0]{0,3}(?:it)?[0-9]{11})(?![0-9])",
      "note": "P.IVA 01234567890: label + exactly 11 digits, no internal spaces",
      "structural": true
    },
    {
      "id": "tax-id.eu-vat",
      "flags": "i",
      "source": "(?:^|[^A-Za-z])((?:vat(?: no\\.?| number| id)?|tva|btw(?:-nummer)?|ust-?id(?:nr)?\\.?)[ :.#\\u00a0]{0,3}[a-z]{2}[0-9]{8,12}(?:b[0-9]{2})?)(?![0-9A-Za-z])",
      "note": "VAT IT01234567890, USt-IdNr. DE123456789, BTW NL123456789B01: country prefix + digits, no internal spaces",
      "structural": true
    },
    {
      "id": "tax-id.pl-nip",
      "flags": "i",
      "source": "(?:^|[^A-Za-z])(nip[ :.#\\u00a0]{0,3}[0-9]{10})(?![0-9])",
      "note": "NIP 1234567890: exactly 10 digits",
      "structural": true
    },
    {
      "id": "iban",
      "flags": "",
      "source": "([A-Z]{2}[0-9]{2}(?:[ ]?[A-Z0-9]{4}){2,7}(?:[ ]?[A-Z0-9]{1,4})?)",
      "note": "IT60 X054 2811 1010 0000 0123 456",
      "structural": true
    }
  ],
