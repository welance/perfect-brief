# develop env (r001-15.develop.welance.space). At deploy time CI wraps this
# file into the develop tenant's env.yaml; the 1Password operator resolves the
# placeholder from vaults/DevOps/items/r001-15_env.develop (field name =
# PB_OPENROUTER_API_KEY). Mock stays the default judge; the LLM judge and the
# model allowlist light up once the vault item exists. Never a real secret here.
PB_OPENROUTER_API_KEY=INJECTED-FROM-DevOpsVault-BY-1PASSWORD-OPERATOR
# First model = authoritative publish judge. Suggestions and verification use
# Flash below; current price metadata and the dated rationale live in ADR 0002.
PB_OPENROUTER_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,google/gemini-3.1-flash-lite
# p007-16 forwards a server-held key as BYOK. Keep this explicit candidate
# allowlist so arbitrary expensive model overrides never reach OpenRouter.
PB_BYOK_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,google/gemini-3.5-flash-lite,google/gemini-3.1-flash-lite,openai/gpt-5-nano,anthropic/claude-haiku-4.5
# generation is high-volume and does not make the publish decision
PB_SUGGEST_MODEL=google/gemini-3.1-flash-lite
# verifier for all-gap repair and optional single-rule screening
PB_VERIFIER_MODEL=deepseek/deepseek-v4-flash
PB_SUGGEST_VERIFY=false
PB_SUGGEST_PROVIDER_SORT=latency
# Keep the single-call judge until a live batching strategy passes end to end.
# V4 Pro scoring is rubric extraction; disable optional reasoning in develop
# to test whether provider-side thinking is the unresolved latency source.
PB_LLM_REASONING_EFFORT=none
PB_DEFAULT_JUDGE=mock
# Noprod's chart creates a Redis Service named `redis`; production alone uses
# an in-pod sidecar and localhost. Graceful: absent Redis = no cache/rate-limit.
PB_REDIS_URL=redis://redis:6379/0
